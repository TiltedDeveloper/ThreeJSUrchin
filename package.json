  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/three": "0.156.0",
    "copy-webpack-plugin": "^12.0.0",
    "http-server": "^14.1.1",
    "pngjs": "^7.0.0",
    "ts-loader": "^9.4.4",
    "typescript": "~5.2.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0",
    "webpack-merge": "^5.9.0"
  }
