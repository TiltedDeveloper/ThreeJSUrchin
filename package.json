{
  "name": "threejs-urchin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "webpack serve --config src/client/webpack.dev.js",
    "build": "webpack --config src/client/webpack.prod.js",
    "preview": "http-server dist/client -a 127.0.0.1 -p 8081 -c-1",
    "typecheck": "tsc --project src/client/tsconfig.json --noEmit",
